# Copy this to .env.local and fill in real values. Never commit .env.local.
#
# Nothing here is required to boot. Every key is optional and the app degrades
# rather than crashing: no Claude key falls back to the free built-in model, no
# Redis falls back to the local JSON file, no Stripe key keeps the paywall off.

# Claude API — https://platform.claude.com
ANTHROPIC_API_KEY=

# Adzuna job search API (free tier) — https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for job searches: us, gb, in, au, ca...
ADZUNA_COUNTRY=us

# RapidAPI key for JSearch (free tier) — surfaces LinkedIn/Indeed/Glassdoor
# postings. Sign up at https://rapidapi.com and subscribe to "JSearch".
RAPIDAPI_KEY=

# ---- Accounts ------------------------------------------------------------
# Email + password sign-in is built in and always on — visitors create an
# account on the sign-in screen, no configuration needed.
#
# AUTH_SECRET signs the login sessions. Leave it blank and the app generates
# one on first run and writes it here automatically. Set your own to control
# it (generate with:  npx auth secret).
AUTH_SECRET=
#
# The providers below are OPTIONAL social logins ("Continue with Google"
# etc.) shown in addition to email/password. Each is free to create, and each
# turns on only when BOTH of its variables are set (see lib/auth.js).
# Google — https://console.cloud.google.com/apis/credentials
# (OAuth client, redirect URI: <your-url>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub — https://github.com/settings/developers
# (OAuth app, callback URL: <your-url>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Microsoft (Outlook / work accounts) — https://entra.microsoft.com
# (App registration, redirect URI: <your-url>/api/auth/callback/microsoft-entra-id)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# ---- Owner ---------------------------------------------------------------
# Which account sees the owner-only Settings panels (signups, creator codes,
# global learnings, feedback). Defaults to the maintainer's address, so set
# this to yours when self-hosting or you will not be the owner of your own
# instance. OWNER_NAME is an optional fallback match on the display name.
OWNER_EMAIL=
OWNER_NAME=

# ---- Storage -------------------------------------------------------------
# Local and self-hosted runs need nothing here: the whole database is one JSON
# file at data/db.json. Serverless hosts have a read-only filesystem and no
# shared memory between invocations, so there the same document lives in a
# single Redis key instead. Either spelling works — Upstash's own integration
# sets the first pair, a Vercel Marketplace Redis store sets the second.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Free built-in model -------------------------------------------------
# A server-wide Groq key gives accounts working AI with no key of their own,
# after their shared Claude allowance runs out. Free at https://console.groq.com
GROQ_API_KEY=
# Override only to point at a compatible proxy; defaults to Groq's API.
# GROQ_BASE_URL=

# ---- Password reset email ------------------------------------------------
# Without a Resend key the reset link is logged to the server console instead
# of emailed, which is fine locally. Free at https://resend.com
RESEND_API_KEY=
# Defaults to "jobblast <noreply@jobblast.nl>" — change it to a domain you
# have verified with Resend, or delivery will fail.
RESEND_FROM=
# RESEND_BASE_URL=

# ---- Billing -------------------------------------------------------------
# The tier gate is OFF unless PAYWALL_ENABLED is "true" or "1". While it is
# off every account gets unlimited access, but usage is still counted and
# every would-have-blocked moment is still recorded — the measurement has to
# exist before the gate does. The ATS resume score is never gated either way.
PAYWALL_ENABLED=
# Checkout stays disabled until a Stripe key is present, even with the
# paywall on. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ---- Kill switches -------------------------------------------------------
# Set to "true" to stop auto-apply drafting for everyone, regardless of tier
# or per-account preference. Spend protection, not a feature flag.
AUTO_APPLY_DISABLED=

# ---- Deployment ----------------------------------------------------------
# Canonical origin for OG images and absolute links. Vercel injects its own
# deployment URL, and dev falls back to http://localhost:3000, so this is only
# needed when serving from a custom domain.
NEXT_PUBLIC_SITE_URL=
